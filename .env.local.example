# ── App URL ────────────────────────────────────────────────────────────────────
# Production : https://www.viralynz.com (recommandé — même URL que le domaine public).
# Si absent en prod Vercel, le code utilise https://www.viralynz.com par défaut
# (évite les liens email qui pointent vers *.vercel.app).
# Local : http://localhost:3000
#
# Supabase → Authentication → URL Configuration :
#   Site URL : https://www.viralynz.com
#   Redirect URLs (ajouter chaque ligne) :
#     https://www.viralynz.com/auth/callback
#     https://www.viralynz.com/reset-password
#     http://localhost:3000/auth/callback
#     http://localhost:3000/reset-password
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ───────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — KEEP SECRET, server-only, never commit
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MEMORY_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ENABLE_QUALITY_ESCALATION=false
QUALITY_ESCALATION_MODEL=
MEMORY_PROCESS_SYNC=false
MEMORY_MAX_FACTS_STARTER=120
MEMORY_MAX_FACTS_PRO=600
MEMORY_MAX_FACTS_LIFETIME=1500
MEMORY_CRON_SECRET=

# Resend / emails transactionnels
# RESEND_FROM_EMAIL doit utiliser un domaine verifie dans Resend, jamais resend.dev en production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPPORT_EMAIL=

# ── Stripe (Starter/Pro subscriptions + Lifetime one-time) ─────────────────────
# Local uniquement : les noms canoniques ci-dessous doivent utiliser le mode test.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret — Developers → Webhooks → endpoint https://…/api/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...
# Outils opératoires TEST uniquement (`scripts/create-stripe-test-webhook.mjs`).
VIRALYNZ_WEBHOOK_URL=https://<alias-preview-stable>.vercel.app/api/webhook
STRIPE_WEBHOOK_ENDPOINT_ID=we_...

# Vercel : variables volontairement séparées. Preview lit uniquement STRIPE_TEST_* ;
# Production lit uniquement STRIPE_LIVE_*. Ne partage jamais une même variable entre les deux.
STRIPE_TEST_SECRET_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_PORTAL_CONFIGURATION_ID=
STRIPE_TEST_STARTER_PRICE_ID=
STRIPE_TEST_PRO_PRICE_ID=
STRIPE_TEST_LIFETIME_PRICE_ID=
# Lecture des anciens abonnements TEST uniquement ; jamais proposés au Checkout.
STRIPE_TEST_LEGACY_PRO_PRICE_ID=
STRIPE_TEST_PRICE_CREATOR_MONTHLY=
STRIPE_TEST_PRICE_PRO_MONTHLY=
STRIPE_TEST_PRICE_PRO_YEARLY=
STRIPE_TEST_PRICE_PRO=
STRIPE_TEST_PRICE_ELITE=
STRIPE_TEST_PRICE_SCALE_MONTHLY=
STRIPE_TEST_PRICE_SCALE_YEARLY=
STRIPE_TEST_PRICE_LIFETIME_ONETIME=
STRIPE_LIVE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVE_STARTER_PRICE_ID=
STRIPE_LIVE_PRO_PRICE_ID=
STRIPE_LIVE_LIFETIME_PRICE_ID=
# Lecture des anciens abonnements LIVE uniquement ; jamais proposés au Checkout.
STRIPE_LIVE_LEGACY_PRO_PRICE_ID=
STRIPE_LIVE_PRICE_CREATOR_MONTHLY=
STRIPE_LIVE_PRICE_PRO_MONTHLY=
STRIPE_LIVE_PRICE_PRO_YEARLY=
STRIPE_LIVE_PRICE_PRO=
STRIPE_LIVE_PRICE_ELITE=
STRIPE_LIVE_PRICE_SCALE_MONTHLY=
STRIPE_LIVE_PRICE_SCALE_YEARLY=
STRIPE_LIVE_PRICE_LIFETIME_ONETIME=

# Compatibilité lecture seule des anciens clients ; jamais utilisée pour un nouveau Checkout.
STRIPE_LEGACY_PRO_PRICE_ID=
STRIPE_PRICE_ELITE=
# Garde-fou temporaire pour une migration Stripe explicitement validée.
CONFIRM_STRIPE_MIGRATION=false
# Prix Stripe.
# Starter/Pro : Products → Add price → Recurring monthly.
# Lifetime : Products → Add price → One-time, 149 EUR.
STRIPE_PRICE_CREATOR_MONTHLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_SCALE_MONTHLY=price_...
STRIPE_PRICE_SCALE_YEARLY=price_...
STRIPE_PRICE_LIFETIME_ONETIME=price_...
# Ancien alias Pro conservé pour certains environnements locaux.
STRIPE_PRICE_PRO=price_...
# Affichage UI : montants dans lib/stripe-pricing.ts (EUR affiché)

# ── TikTok Login Kit (OAuth) — optionnel — lier le compte TikTok au dashboard ──
# Crée une app sur https://developers.tiktok.com/ → ajoute le produit « Login Kit ».
# Redirect URI à enregistrer (exactement, avec le bon host) :
#   http://localhost:3000/api/tiktok/callback
#   https://<alias-preview-stable>.vercel.app/api/tiktok/callback   (Preview/sandbox)
#   https://www.viralynz.com/api/tiktok/callback   (prod)
# Scopes pour la review/sandbox si activés dans TikTok Dev :
# user.info.basic,user.info.profile,user.info.stats,video.list
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
TIKTOK_OAUTH_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list
# Valeurs locales/sandbox. Sur Vercel, configure chaque environnement avec son URL exacte.
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback
TIKTOK_ENV=sandbox
NEXT_PUBLIC_TIKTOK_ENV=sandbox
TIKTOK_APP_MODE=sandbox
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# 32 octets encodés en base64 ou 64 caractères hexadécimaux. Ne jamais réutiliser JWT_SECRET.
TIKTOK_TOKEN_ENCRYPTION_KEY=

# Trend Intelligence / Radar tendances
# APIFY_TOKEN reste serveur-only. Ne jamais prefixer en NEXT_PUBLIC.
APIFY_TOKEN=
APIFY_TIKTOK_TRENDS_ACTOR_ID=
APIFY_TIKTOK_SEARCH_ACTOR_ID=
APIFY_TIKTOK_HASHTAG_ACTOR_ID=
TREND_SCAN_COUNTRIES=FR,BE,CA
TREND_SCAN_LANGUAGE=fr
TREND_SCAN_DEFAULT_NICHES=business,coaching,ecommerce,creator_growth,fitness,beauty,education,lifestyle
TREND_SCAN_MAX_ITEMS=100
TREND_SCAN_CACHE_MINUTES=180
CRON_SECRET=
# Local uniquement : affiche un badge Mode demo et utilise un petit echantillon local si Apify est absent.
NEXT_PUBLIC_TRENDS_DEMO_MODE=false
